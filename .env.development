# 环境配置
NODE_ENV=development

# MySQL 应用用户配置（需与 init.sql 中的用户一致）
# 宿主机直跑 ts-node 用 127.0.0.1；core 跑在 Docker 内时由 docker-compose.yml 覆盖为容器名 datapolit-mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=datapolit-core
DB_PASSWORD=core_password
DB_NAME=datapolit

# MySQL 容器初始化变量
MYSQL_ROOT_PASSWORD=datapolit-root
MYSQL_DATABASE=datapolit
MYSQL_USER=datapolit-core
MYSQL_PASSWORD=core_password

# 服务器配置
PORT=3002

# Swagger 配置
ENABLE_SWAGGER=true

# doc-kit 文档服务（BFF 代理目标）
# 宿主机直跑用 127.0.0.1；core 跑在 Docker 内时由 docker-compose.yml 覆盖为容器名 datapolit-dockit
DOC_KIT_HOST=127.0.0.1
DOC_KIT_PORT=8100
DOC_KIT_URL=http://127.0.0.1:8100
DOC_KIT_TIMEOUT_MS=300000

# docs-seeker RAG 问答服务（评估集在线运行目标）
# 宿主机直跑用 127.0.0.1；core 跑在 Docker 内时由 docker-compose.yml 覆盖为容器名 datapolit-docs-seeker
DOCS_SEEKER_HOST=127.0.0.1
DOCS_SEEKER_PORT=8001
DOCS_SEEKER_URL=http://127.0.0.1:8001
DOCS_SEEKER_TIMEOUT_MS=60000

# 评估集在线运行并发度（同时调 docs-seeker /v1/chat 的请求数上限）
EVAL_CONCURRENCY=4