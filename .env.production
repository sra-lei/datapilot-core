# Node.js 服务配置
NODE_ENV=production

# MySQL 应用用户配置
DB_HOST=datapolit-mysql
DB_PORT=3306
DB_USER=datapolit-core
DB_PASSWORD=core_password
DB_NAME=datapolit

# MySQL root 用户配置
MYSQL_ROOT_PASSWORD=datapolit-root
MYSQL_DATABASE=datapolit
MYSQL_USER=datapolit-core
MYSQL_PASSWORD=core_password

# 服务器配置
PORT=3002

# Swagger 配置
ENABLE_SWAGGER=true

# doc-kit 文档服务（BFF 代理目标；容器名统一为 datapolit-dockit）
DOC_KIT_HOST=datapolit-dockit
DOC_KIT_PORT=8100
DOC_KIT_URL=http://datapolit-dockit:8100
DOC_KIT_TIMEOUT_MS=300000

# docs-seeker RAG 问答服务（评估集在线运行目标；容器名统一为 datapolit-docs-seeker）
DOCS_SEEKER_HOST=datapolit-docs-seeker
DOCS_SEEKER_PORT=8001
DOCS_SEEKER_URL=http://datapolit-docs-seeker:8001
DOCS_SEEKER_TIMEOUT_MS=60000

# 评估集在线运行并发度（同时调 docs-seeker /v1/chat 的请求数上限）
EVAL_CONCURRENCY=4

IMAGE_NAME=ccr.ccs.tencentyun.com/sra.io/datapolit-core